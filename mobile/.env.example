# ==============================================================================
# COLLEGE MANAGEMENT PORTAL - MOBILE ENVIRONMENT CONFIGURATION
# ==============================================================================
# All client-side environment variables consumed by Expo MUST begin with EXPO_PUBLIC_.
# Do NOT store database passwords, JWT secrets, or administrative credentials here.
# ==============================================================================

# --- 1. LOCAL DEVELOPMENT WITH ANDROID EMULATOR ---
# 10.0.2.2 routes from the Android emulator back to the host machine's localhost:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# --- 2. PHYSICAL ANDROID DEVICE TESTING (Same Wi-Fi Network) ---
# Replace with your development PC's local network IPv4 address:
# EXPO_PUBLIC_API_URL=http://192.168.1.6:5000/api/v1

# --- 3. PRODUCTION RENDER CLOUD BACKEND DEPLOYMENT ---
# Set this URL when building the production APK / AAB with EAS:
EXPO_PUBLIC_API_URL=https://collegemanagement-dd16.onrender.com/api/v1

# --- 4. APPLICATION METADATA ---
EXPO_PUBLIC_APP_NAME="College Management Portal"
EXPO_PUBLIC_APP_VERSION="1.0.0"


